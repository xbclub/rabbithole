# rabbithole 客户端镜像(基于 CI 预编译的 linux gnu 二进制)。
# 与服务端镜像同约束:Dockerfile 内无 RUN 步骤,多架构在 CI 逐架构单平台构建
# 再 manifest 合并,全程不需要 QEMU;二进制统一 COPY --chmod=755 落位。
#
# 用法一(推荐,零配置文件):环境变量直连,凭据在控制台「客户端」页创建
#   docker run -d --name rh-client --restart unless-stopped \
#     -e RH_SERVER=example.com:7100 \
#     -e RH_CLIENT_ID=<客户端ID> -e RH_SECRET=<密钥> \
#     ghcr.io/xbclub/rabbithole-client:latest
#   可选:RH_PROTOCOL / RH_MULTIPLEX / RH_TLS_INSECURE / RH_LOG_LEVEL 等(见 rh-client config.rs)
#
# 用法二(高级项:自定义 CA/代理/STUN):挂载 TOML 配置
#   -v $PWD/client.toml:/etc/rabbithole/client.toml:ro   # 模板:deploy/client.example.toml
#
# 本地构建(先准备静态二进制):
#   cross build --release --target x86_64-unknown-linux-gnu -p rh-client
#   mkdir -p bin/amd64 && cp target/x86_64-unknown-linux-gnu/release/rh-client bin/amd64/
#   docker build -f deploy/Dockerfile.client --build-arg BIN_DIR=bin/amd64 -t rabbithole-client:local .
# 基础镜像 debian-slim:二进制为 gnu 动态链接(glibc);入口脚本是纯 POSIX sh(dash 兼容)。
# (2026-11-03 弃 alpine+musl:三机实测 musl 产物单流比 gnu 慢 ~7-9%,性能优先)
FROM debian:13-slim
ARG BIN_DIR=bin/amd64
COPY --chmod=755 ${BIN_DIR}/rh-client /usr/local/bin/
COPY --chmod=755 deploy/docker-entrypoint-client.sh /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]
