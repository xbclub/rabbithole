# Docker image staging bin/ (deploy/Dockerfile)
/bin/

# Benchmark measurement evidence (large raw artifacts, kept on disk only)
benchmark/runs/

# Raw measurement data (jsonl): per-run probe/instrumentation records, kept on
# disk only. They are machine-generated, large, and may carry environment
# specifics (internal host addresses) that should not enter version control.
# Analysis conclusions belong in the markdown reports instead.
*.jsonl

# Python bytecode cache
__pycache__/
*.pyc

# Third-party reference sources fetched for performance comparison (frp v0.71.0
# and its fmux implementation). Read-only research material, not part of the
# build: the workspace depends on `vendor/yamux`, never on these trees.
benchmark/frp-src-v0.71.0/
benchmark/frp-yamux-src/

# Stray frontend bundle fragments dropped at the repo root by a build tool.
# Matches the Vite/React chunk naming pattern only; real sources live under
# console/src.
/workflow-*.js

# pnpm 的本地内容寻址存储(构建前端时按需重建,不入库)
/.pnpm-store/
